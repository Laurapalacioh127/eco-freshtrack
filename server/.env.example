# Server
PORT=3001
NODE_ENV=development

# Database - Supabase Transaction pooler
DB_HOST=
DB_PORT=6543
DB_USER=
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=true

# Supabase - server-only, never expose to client
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Open Food Facts (public API, no key)
OPEN_FOOD_FACTS_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_TIMEOUT_MS=5000
